{
  "name": "@krowds/ui",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Shared shadcn/ui Components, Blocks, Charts, Typeset, and design primitives for KROWDS.",
  "sideEffects": [
    "**/*.css"
  ],
  "imports": {
    "#components/*": "./src/components/*.tsx",
    "#lib/*": "./src/lib/*.ts"
  },
  "exports": {
    ".": "./src/index.ts",
    "./components/*": "./src/components/*.tsx",
    "./globals.css": "./src/styles/globals.css",
    "./lib/*": "./src/lib/*.ts",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsc --noEmit",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@krowds/utils": "workspace:*",
    "class-variance-authority": "^0.7.1",
    "lucide-react": "^1.48.0",
    "shadcn": "4.21.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@krowds/tsconfig": "workspace:*",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9.39.5",
    "react": "19.3.0",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "peerDependencies": {
    "react": ">=19",
    "react-dom": ">=19"
  }
}
